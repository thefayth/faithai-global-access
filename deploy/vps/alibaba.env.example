# Regular Alibaba Cloud Model Studio API only; never a Coding/Token Plan key.
# Copy no values from an unrelated region, account or OpenAI configuration.
FAITHAI_AI_PROVIDER=alibaba
FAITHAI_AI_ENABLED=false
FAITHAI_AI_ENDPOINT=
FAITHAI_AI_MODEL=
DASHSCOPE_API_KEY=
FAITHAI_AI_API_KEY=
# Set only after reviewing this specific model/region's worst-case request cost.
FAITHAI_AI_MAX_CALL_USD=
FAITHAI_AI_MAX_OUTPUT_TOKENS=512
FAITHAI_AI_MAX_CHARS=2000
FAITHAI_AI_DAILY_USD_CAP=1
FAITHAI_AI_MONTHLY_USD_CAP=25
FAITHAI_AI_CALLS_PER_SESSION=3
FAITHAI_LIVE_TERRITORIES=us
