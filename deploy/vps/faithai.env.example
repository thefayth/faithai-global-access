FAITHAI_ENVIRONMENT=production
FAITHAI_API_PORT=8791
FAITHAI_REQUIRE_DATABASE=true
FAITHAI_DB_SSL=false
FAITHAI_DB_POOL_MAX=5
FAITHAI_LIVE_TERRITORIES=global
FAITHAI_AI_ENABLED=false
FAITHAI_ADSENSE_ENABLED=false
# Reviewed ExoClick zone 5998322: FAITHAI GENERAL NATIVE TEXT.
FAITHAI_EXOCLICK_ENABLED=true
FAITHAI_STRIPE_ENABLED=false
FAITHAI_PAYSTACK_ENABLED=false
FAITHAI_FLUTTERWAVE_ENABLED=false
FAITHAI_CONTENT_SYNC_ENABLED=false
FAITHAI_EMERGENCY_ENABLED=true
DATABASE_URL=postgresql://faithai:REPLACE_LOCALLY@127.0.0.1:5432/faithai
FAITHAI_BACKUP_DIR=/var/backups/faithai
