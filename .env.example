VITE_FAITHAI_WALKTHROUGH_DEFAULT=true

# Public, non-secret client controls. Keep provider code disabled until a reviewed pilot.
VITE_AD_PROVIDERS=
VITE_GOOGLE_ADSENSE_CLIENT=
VITE_EXOCLICK_SCRIPT_URL=https://a.magsrv.com/ad-provider.js
VITE_EXOCLICK_ZONE_ID=
VITE_EXOCLICK_ZONE_CLASS=eas6a97888e20
VITE_AD_LOAD_TIMEOUT_MS=4000
VITE_SPONSOR_LABEL=

# Server/Worker variables. Never put API keys, webhook secrets, or payment credentials in VITE_*.
FAITHAI_ENVIRONMENT=local
FAITHAI_LIVE_TERRITORIES=global
FAITHAI_AI_ENABLED=false
FAITHAI_ADSENSE_ENABLED=false
FAITHAI_EXOCLICK_ENABLED=false
FAITHAI_STRIPE_ENABLED=false
FAITHAI_PAYSTACK_ENABLED=false
FAITHAI_FLUTTERWAVE_ENABLED=false
FAITHAI_CONTENT_SYNC_ENABLED=false
FAITHAI_EMERGENCY_ENABLED=false
FAITHAI_AI_DAILY_USD_CAP=1
FAITHAI_AI_MONTHLY_USD_CAP=25
FAITHAI_AI_CALLS_PER_SESSION=3
FAITHAI_AI_MAX_CHARS=2000
FAITHAI_AI_PROVIDER=alibaba
FAITHAI_AI_ENDPOINT=
FAITHAI_AI_MODEL=
FAITHAI_AI_MAX_CALL_USD=
FAITHAI_AI_MAX_OUTPUT_TOKENS=512
FAITHAI_AI_API_KEY=
DASHSCOPE_API_KEY=
FAITHAI_PUBLIC_WRITES_ENABLED=false

# VPS runtime. DATABASE_URL is server-only and must be stored outside the client build.
DATABASE_URL=
FAITHAI_REQUIRE_DATABASE=false
FAITHAI_DB_SSL=false
FAITHAI_DB_POOL_MAX=5
FAITHAI_API_PORT=8788
